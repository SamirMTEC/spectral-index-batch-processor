{
  "name": "spectral-index",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @spectral-index/web",
    "build": "npm run build --workspace @spectral-index/web",
    "lint": "npm run lint --workspace @spectral-index/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace @spectral-index/web",
    "test": "npm run test --workspace @spectral-index/web"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.7.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
