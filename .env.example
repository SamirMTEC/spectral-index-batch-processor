# Copy this file to .env for local development. Empty values below are secrets:
# generate them locally and keep them in a secret manager in production.
# Never commit .env, database URLs, Redis URLs, R2 keys, tokens, or passwords.

POSTGRES_DB=spectral_index
POSTGRES_USER=spectral
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_PORT=6379
API_PORT=8000

SPECTRAL_ENVIRONMENT=development
SPECTRAL_LOG_LEVEL=INFO
SPECTRAL_SOFTWARE_VERSION=0.1.0
# Development-only identity bridge. Keep false or unset outside local/test environments.
SPECTRAL_DEV_AUTH_ENABLED=true
# Local examples use localhost. Production URLs must come from the managed
# PostgreSQL/Redis secret stores and must require TLS.
SPECTRAL_DATABASE_URL=
SPECTRAL_DATABASE_POOL_SIZE=5
SPECTRAL_DATABASE_MAX_OVERFLOW=5
SPECTRAL_DATABASE_POOL_TIMEOUT_SECONDS=10
SPECTRAL_DATABASE_POOL_RECYCLE_SECONDS=300
SPECTRAL_REDIS_URL=
SPECTRAL_REDIS_STREAM=spectral:jobs
SPECTRAL_REDIS_CONSUMER_GROUP=spectral-workers
SPECTRAL_PROCESSING_CONCURRENCY=2
SPECTRAL_S3_ENDPOINT_URL=http://localhost:9000
SPECTRAL_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
SPECTRAL_S3_REGION=us-east-1
SPECTRAL_S3_BUCKET=spectral-index
SPECTRAL_S3_ACCESS_KEY_ID=
SPECTRAL_S3_SECRET_ACCESS_KEY=
SPECTRAL_S3_FORCE_PATH_STYLE=true
SPECTRAL_STORAGE_CONNECT_TIMEOUT_SECONDS=5
SPECTRAL_STORAGE_READ_TIMEOUT_SECONDS=60
SPECTRAL_STORAGE_MAX_CONNECTIONS=20
SPECTRAL_UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
SPECTRAL_UPLOAD_PART_SIZE_BYTES=8388608
SPECTRAL_UPLOAD_URL_EXPIRY_SECONDS=900
SPECTRAL_UPLOAD_SESSION_EXPIRY_SECONDS=86400
SPECTRAL_UPLOAD_MAX_FILES_PER_SESSION=10000
SPECTRAL_UPLOAD_MAX_FILE_BYTES=53687091200
SPECTRAL_UPLOAD_MAX_SESSION_BYTES=107374182400
SPECTRAL_UPLOAD_MAX_DATASET_BYTES=1099511627776
SPECTRAL_ZIP_MAX_ENTRIES=10000
SPECTRAL_ZIP_MAX_ENTRY_BYTES=53687091200
SPECTRAL_ZIP_MAX_UNCOMPRESSED_BYTES=107374182400
SPECTRAL_ZIP_MAX_COMPRESSION_RATIO=200
SPECTRAL_ZIP_MAX_PATH_DEPTH=16
SPECTRAL_RASTER_MAX_PIXELS=500000000
SPECTRAL_RASTER_MAX_BANDS=64
SPECTRAL_RASTER_MAX_DECODED_BYTES=68719476736
SPECTRAL_API_MAX_REQUEST_BYTES=16777216
SPECTRAL_API_REQUEST_TIMEOUT_SECONDS=30
SPECTRAL_API_WORKERS=2
SPECTRAL_API_KEEPALIVE_SECONDS=5
SPECTRAL_GRACEFUL_SHUTDOWN_SECONDS=45
SPECTRAL_READINESS_TIMEOUT_SECONDS=5
SPECTRAL_API_RATE_LIMIT_REQUESTS=600
SPECTRAL_UPLOAD_RATE_LIMIT_REQUESTS=60
SPECTRAL_RATE_LIMIT_WINDOW_SECONDS=60
SPECTRAL_PROCESSING_TASK_SOFT_LIMIT_SECONDS=900
SPECTRAL_PROCESSING_TASK_HARD_LIMIT_SECONDS=930
SPECTRAL_PROCESSING_MAX_TASKS_PER_CHILD=25
SPECTRAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

VITE_API_BASE_URL=http://localhost:8000

# Production hostnames (non-secret reference values)
SPECTRAL_PUBLIC_APP_URL=https://spectral.classlab.com.br
SPECTRAL_PUBLIC_API_URL=https://api-spectral.classlab.com.br
# R2 production values replace the S3 values above:
# SPECTRAL_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# SPECTRAL_S3_PUBLIC_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# SPECTRAL_S3_REGION=auto
# SPECTRAL_S3_FORCE_PATH_STYLE=false
# SPECTRAL_CORS_ORIGINS=["https://spectral.classlab.com.br"]
# SPECTRAL_ENVIRONMENT=production
# SPECTRAL_DEV_AUTH_ENABLED=false
